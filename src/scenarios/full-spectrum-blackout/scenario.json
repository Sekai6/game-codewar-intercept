  "guidance": {
    "briefing": {
      "strategicBackground": ["1988年，挪威海与巴伦支海交界。异常太阳活动正在扰乱高纬度无线电传播。", "双方海空兵力仍按既定任务接近，但远程指挥与共享态势可能无法维持。"],
      "blueMission": ["保护Long Beach与CG-57组成的NTU水面编队。", "维持E-2C与F-14构成的预警、CAP屏障。", "阻止Tu-16K进入有效反舰发射区域。", "失联后依照最后命令与本地传感器继续行动。"],
      "intelligenceEstimate": ["东北方向可能存在苏联远程航空攻击群及护航机。", "更深远空域可能有AEW支援，东侧海域可能存在苏联水面作战群。", "敌情图仅代表任务前估计，不代表实时真值。"],
      "features": ["Link 11与苏联C2将逐步退化，而不是被瞬间关闭。", "不同平台会保留不同且可能冲突的最后态势。", "通信恢复时，报告需要重新交付并逐步融合。", "所有舰载武器仍遵循本舰火控、弹药与实体发射器闭环。"],
      "controls": ["使用舰船、飞机与导弹镜头快捷键观察实体。", "打开战术网络视图可观察轮询、丢包和航迹老化。", "可暂停或调整时间倍率；关键提示不会因加速而跳过。", "引导可在完整、关键事件和关闭三档间切换。"]
    },
    "estimatedContactWindow": [180, 420],
    "cues": [
      { "id": "cue-opening-network", "level": "full", "trigger": { "type": "time", "at": 20 }, "title": "编队正在展开", "message": "建议打开战术网络视图，观察Link 11在正常阶段如何轮询和转发航迹。", "category": "mission", "focus": { "kind": "network", "label": "打开战术网络视图" }, "expiresAfter": 24, "once": true },
      { "id": "cue-contact-window", "level": "full", "trigger": { "type": "time", "at": 105 }, "title": "接触窗口临近", "message": "任务规划预计在T+180至420秒间出现首次有效接触；这是预案估计，不是敌方真值。", "category": "sensor", "focus": { "kind": "overview", "label": "查看战术全景" }, "expiresAfter": 30, "once": true },
      { "id": "cue-warning", "level": "critical", "trigger": { "type": "space-weather-phase", "phase": "warning" }, "title": "空间天气告警", "message": "HF噪声和导航漂移开始上升，网络报告的延迟与不确定度将逐步增加。", "category": "weather", "focus": { "kind": "network", "label": "检查链路状态" }, "expiresAfter": 35, "once": true },
      { "id": "cue-flare", "level": "critical", "trigger": { "type": "space-weather-phase", "phase": "solar-flare" }, "title": "太阳耀斑抵达", "message": "高纬通信传播正在快速恶化。注意比较各平台本地航迹与共享态势。", "category": "weather", "focus": { "kind": "network", "label": "比较本地与网络态势" }, "expiresAfter": 35, "once": true },
      { "id": "cue-network-degraded", "level": "critical", "trigger": { "type": "network-state", "side": "blue", "state": "degraded" }, "title": "Link 11态势开始分化", "message": "Long Beach与CG-57不再保证看到同一幅图；远程武器授权仍需要合法的本舰火控条件。", "category": "network", "focus": { "kind": "formation", "targetId": "blue-ntu-task-group", "label": "观察蓝方水面编队" }, "expiresAfter": 40, "once": true },
      { "id": "cue-blackout", "level": "critical", "trigger": { "type": "space-weather-phase", "phase": "total-blackout" }, "title": "全频带阻塞峰值", "message": "各平台已按失联预案行动。共享态势可能过期，但本地传感器和武器闭环仍继续运行。", "category": "network", "focus": { "kind": "overview", "label": "查看独立平台状态" }, "expiresAfter": 45, "once": true },
      { "id": "cue-cg57-local-track", "level": "full", "trigger": { "type": "confirmed-track", "side": "blue", "classification": "aircraft" }, "title": "友方确认空中航迹", "message": "某一友方传感器已确认空中目标。切换到CG-57可观察其是否具备独立接战条件。", "category": "sensor", "focus": { "kind": "entity", "targetId": "blue-cg-57", "label": "观察CG-57" }, "expiresAfter": 30, "once": true },
      { "id": "cue-e2c-lost-comms", "level": "critical", "trigger": { "type": "platform-lost-comms", "platformId": "blue-e2c-orbit" }, "title": "E-2C失去稳定链路", "message": "CAP只会继续执行最后一项有效命令，随后转入有限搜索或返回预定巡逻区。", "category": "network", "focus": { "kind": "formation", "targetId": "blue-f14-cap", "label": "观察F-14 CAP" }, "expiresAfter": 40, "once": true },
      { "id": "cue-blue-launch", "level": "critical", "trigger": { "type": "weapon-launch", "side": "blue" }, "title": "蓝方武器离架", "message": "该发射来自实体平台的合法传感器、交战队列、火控、弹药及发射器流程。", "category": "combat", "expiresAfter": 24, "once": false },
      { "id": "cue-recovery", "level": "critical", "trigger": { "type": "space-weather-phase", "phase": "recovery" }, "title": "传播条件开始恢复", "message": "积压报告将重新交付，冲突航迹需要按时间、质量和不确定度逐步融合。", "category": "network", "focus": { "kind": "network", "label": "观察态势重新融合" }, "expiresAfter": 50, "once": true },
      { "id": "cue-inactivity", "level": "full", "trigger": { "type": "inactivity", "seconds": 45 }, "title": "仿真仍在推进", "message": "平台正在执行航线、搜索和预案。可切换至AEW、CAP、水面哨舰或战术全景观察。", "category": "mission", "focus": { "kind": "overview", "label": "选择观察目标" }, "expiresAfter": 25, "once": false }
    ]
